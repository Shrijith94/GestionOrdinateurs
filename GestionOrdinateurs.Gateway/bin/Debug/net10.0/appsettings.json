{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
        "Endpoints": {
            "http":{
                "Url": "http://0.0.0.0:5010"
            }
        }
    },
  "ReverseProxy": {
    "Routes": {
      "ordinateur-route": {
        "ClusterId": "API-ordinateur-reparation",
        "Match": {
          "Path": "/api/ordinateurs/{**catch-all}"
        }
      },
      "reparation-route": {
        "ClusterId": "API-ordinateur-reparation",
        "Match": {
          "Path": "/api/reparation/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "API-ordinateur-reparation": {
        "Destinations": {
          "weatherService": {
            "Address": "http://localhost:5075/"
          }
        }
      }
    }
  }
}
